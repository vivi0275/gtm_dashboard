# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored and never committed.
LEMLIST_API_KEY=your_lemlist_api_key_here

# Used to auto-classify reply sentiment (console.anthropic.com).
# Without it the dashboard falls back to the hand-written CURATED block.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
